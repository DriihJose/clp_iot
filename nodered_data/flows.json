    {
        "id": "fn_heartbeat",
        "type": "function",
        "z": "flow_pressao_full",
        "name": "Keepalive InfluxDB",
        "func": "// Roda a cada 2 s.\n// Saída 1: setpoint TRAVADO no início do teste -> InfluxDB, SOMENTE enquanto há teste em andamento.\n// Saída 2: estado da válvula (keepalive para o painel de status do Grafana).\nlet out1 = null;\nif (flow.get('ativo') === true) {\n    const sp = flow.get('sp_travado');\n    if (sp !== undefined && sp !== null && !isNaN(Number(sp))) out1 = { payload: Number(sp) };\n}\nconst val = flow.get('valvula');\nreturn [out1, { payload: (val === true || val === 1 || val === 'true') }];\n",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 1000,
        "wires": [
            [
                "influx_out_setpoint"
            ],
            [
                "15e0a5b19569ae15"
            ]
        ]
    },
