    {
        "id": "8525c1d000560d34",
        "type": "template",
        "z": "flow_pressao_full",
        "name": "Relatório  HTML",
        "field": "payload",
        "fieldType": "msg",
        "format": "html",
        "syntax": "mustache",
        "template": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Relatório de Teste de Pressão</title>\n<style>\n    @page { size: A4 portrait; margin: 12mm; }\n\n    *, *::before, *::after { box-sizing: border-box; }\n\n    html, body { margin: 0; padding: 0; }\n\n    body {\n        font-family: Arial, Helvetica, sans-serif;\n        font-size: 14px;\n        color: #000;\n        -webkit-print-color-adjust: exact;\n        print-color-adjust: exact;\n    }\n\n    .container {\n        width: 100%;\n        border: 2px solid #000;\n        padding: 16px;\n    }\n\n    h1 {\n        text-align: center;\n        margin: 0 0 16px 0;\n        font-size: 22px;\n    }\n\n    h3 {\n        text-align: center;\n        margin: 0 0 8px 0;\n    }\n\n    .linha {\n        margin: 6px 0;\n    }\n\n    /* Caixa de resumo e quadro do gráfico usam EXATAMENTE a mesma largura */\n    .box {\n        width: 100%;\n        margin-top: 16px;\n        padding: 10px;\n        border: 1px solid #000;\n    }\n\n    .box svg {\n        display: block;\n        width: 100%;\n        max-width: 100%;\n        height: auto;\n    }\n\n    .assinatura {\n        margin-top: 36px;\n        text-align: center;\n        page-break-inside: avoid;\n    }\n</style>\n</head>\n<body>\n\n<div class=\"container\">\n\n    <h1>RELATÓRIO DE TESTE DE PRESSÃO</h1>\n\n    <div class=\"linha\"><b>Equipamento:</b> {{payload.equipamento}}</div>\n    <div class=\"linha\"><b>Início:</b> {{payload.inicio}}</div>\n    <div class=\"linha\"><b>Fim:</b> {{payload.fim}}</div>\n\n    <div class=\"box\">\n        <div class=\"linha\"><b>Setpoint:</b> {{payload.sp}} bar</div>\n        <div class=\"linha\"><b>Média:</b> {{payload.media}} bar</div>\n        <div class=\"linha\"><b>Mínima:</b> {{payload.min}} bar</div>\n        <div class=\"linha\"><b>Máxima:</b> {{payload.max}} bar</div>\n        <div class=\"linha\"><b>Erro Máximo:</b> {{payload.erro}} bar</div>\n\n        <div class=\"linha\">\n            <b>Status:</b>\n            <span style=\"color: {{payload.status == 'APROVADO' ? 'green' : 'red'}};\">\n                {{payload.status}}\n            </span>\n        </div>\n    </div>\n\n    <div class=\"box\">\n        <h3>Gráfico de Pressão</h3>\n\n        <svg viewBox=\"0 0 1000 300\" preserveAspectRatio=\"xMidYMid meet\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"Arial, Helvetica, sans-serif\" font-size=\"14\">\n\n            <!-- eixo -->\n            <line x1=\"50\" y1=\"240\" x2=\"950\" y2=\"240\" stroke=\"black\" />\n\n            <!-- escala Y -->\n            <text x=\"20\" y=\"240\">0</text>\n            <text x=\"20\" y=\"220\">1</text>\n            <text x=\"20\" y=\"200\">2</text>\n            <text x=\"20\" y=\"180\">3</text>\n            <text x=\"20\" y=\"160\">4</text>\n            <text x=\"20\" y=\"140\">5</text>\n            <text x=\"20\" y=\"120\">6</text>\n            <text x=\"20\" y=\"100\">7</text>\n            <text x=\"20\" y=\"80\">8</text>\n            <text x=\"20\" y=\"60\">9</text>\n            <text x=\"20\" y=\"40\">10</text>\n\n            <!-- grid -->\n            <line x1=\"50\" y1=\"220\" x2=\"950\" y2=\"220\" stroke=\"#ccc\" />\n            <line x1=\"50\" y1=\"200\" x2=\"950\" y2=\"200\" stroke=\"#ccc\" />\n            <line x1=\"50\" y1=\"180\" x2=\"950\" y2=\"180\" stroke=\"#ccc\" />\n            <line x1=\"50\" y1=\"160\" x2=\"950\" y2=\"160\" stroke=\"#ccc\" />\n            <line x1=\"50\" y1=\"140\" x2=\"950\" y2=\"140\" stroke=\"#ccc\" />\n            <line x1=\"50\" y1=\"120\" x2=\"950\" y2=\"120\" stroke=\"#ccc\" />\n            <line x1=\"50\" y1=\"100\" x2=\"950\" y2=\"100\" stroke=\"#ccc\" />\n            <line x1=\"50\" y1=\"80\" x2=\"950\" y2=\"80\" stroke=\"#ccc\" />\n            <line x1=\"50\" y1=\"60\" x2=\"950\" y2=\"60\" stroke=\"#ccc\" />\n            <line x1=\"50\" y1=\"40\" x2=\"950\" y2=\"40\" stroke=\"#ccc\" />\n\n            <!-- pressão -->\n            <polyline fill=\"none\" stroke=\"blue\" stroke-width=\"2\" points=\"{{payload.pontos}}\" />\n\n            <!-- setpoint -->\n            <line x1=\"50\" y1=\"{{payload.linhaSP}}\" x2=\"950\" y2=\"{{payload.linhaSP}}\" stroke=\"red\" stroke-dasharray=\"5,5\" />\n\n            <!-- ponto da falha -->\n            {{#payload.falhaX}}\n            <circle cx=\"{{payload.falhaX}}\" cy=\"{{payload.falhaY}}\" r=\"5\" fill=\"red\" />\n\n            <text x=\"{{payload.falhaX}}\" y=\"{{payload.falhaYTxt}}\" font-size=\"12\" text-anchor=\"middle\" fill=\"red\">\n                {{payload.falhaValor}} bar\n            </text>\n            {{/payload.falhaX}}\n\n            <!-- eixo X -->\n            <text x=\"50\" y=\"270\" text-anchor=\"middle\">{{payload.t0}}</text>\n            <text x=\"125\" y=\"270\" text-anchor=\"middle\">{{payload.t1}}</text>\n            <text x=\"200\" y=\"270\" text-anchor=\"middle\">{{payload.t2}}</text>\n            <text x=\"275\" y=\"270\" text-anchor=\"middle\">{{payload.t3}}</text>\n            <text x=\"350\" y=\"270\" text-anchor=\"middle\">{{payload.t4}}</text>\n            <text x=\"425\" y=\"270\" text-anchor=\"middle\">{{payload.t5}}</text>\n            <text x=\"500\" y=\"270\" text-anchor=\"middle\">{{payload.t6}}</text>\n            <text x=\"575\" y=\"270\" text-anchor=\"middle\">{{payload.t7}}</text>\n            <text x=\"650\" y=\"270\" text-anchor=\"middle\">{{payload.t8}}</text>\n            <text x=\"725\" y=\"270\" text-anchor=\"middle\">{{payload.t9}}</text>\n            <text x=\"800\" y=\"270\" text-anchor=\"middle\">{{payload.t10}}</text>\n            <text x=\"875\" y=\"270\" text-anchor=\"middle\">{{payload.t11}}</text>\n            <text x=\"950\" y=\"270\" text-anchor=\"middle\">{{payload.t12}}</text>\n\n            <!-- legenda -->\n            <line x1=\"200\" y1=\"288\" x2=\"230\" y2=\"288\" stroke=\"blue\" stroke-width=\"2\" />\n            <text x=\"240\" y=\"293\" fill=\"blue\">Pressão</text>\n\n            <line x1=\"530\" y1=\"288\" x2=\"620\" y2=\"288\" stroke=\"red\" stroke-dasharray=\"5,5\" />\n            <text x=\"630\" y=\"293\" fill=\"red\">Setpoint</text>\n\n        </svg>\n    </div>\n\n    <div class=\"assinatura\">\n        <div class=\"linha\">_____________________________________</div>\n        <div class=\"linha\">Responsável pelo teste</div>\n        <div class=\"linha\"><b>Data:</b> {{payload.emissao}}</div>\n    </div>\n\n</div>\n\n</body>\n</html>\n",
        "x": 900,
        "y": 580,
        "wires": [
            [
                "4e72940d3bb63eec"
            ]
        ]
    },
    {
        "id": "7d655f418f1c0085",
        "type": "function",
        "z": "flow_pressao_full",
        "name": "Coleta pressão",
        "func": "let ativo = flow.get('ativo');\n\n//if (!ativo) return null; // só grava quando ativo\n\nlet valor = Number(msg.payload);\n\n// ignora valores inválidos (0, null, NaN)\n if (!valor || valor <= 0) return null;\n\n// média\nlet soma = flow.get('soma') || 0;\nlet qtd = flow.get('qtd') || 0;\n\nsoma += valor;\nqtd += 1;\n\nflow.set('soma', soma);\nflow.set('qtd', qtd);\n\n// min max\nlet min = flow.get('min');\nlet max = flow.get('max');\n\nif (min === null || valor < min) flow.set('min', valor);\nif (max === null || valor > max) flow.set('max', valor);\n\n// histórico LIMPO\nlet historico = flow.get('historico') || [];\n\nhistorico.push({\n    v: valor,\n    t: Date.now()\n});\n\n//  mantém só últimos 10 minutos (ajustável)\nlet agora = Date.now();\nhistorico = historico.filter(p => agora - p.t <= 600000);\n\nflow.set('historico', historico);\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 756.9318181818181,
        "wires": [
            [
                "gauge",
                "bb3820654f2359db"
            ]
        ]
    },
    {
        "id": "5214bd83dc5b5467",
        "type": "function",
        "z": "flow_pressao_full",
        "name": "Decremento de tempo",
        "func": "// Roda a cada 1 s (inject). Saídas: 1 = tempo restante | 2 = finalização automática | 3 = status do teste\nconst fmt = (ms) => {\n    const total = Math.max(0, Math.ceil(ms / 1000));      // segundos restantes (arredonda p/ cima)\n    const mm = String(Math.floor(total / 60)).padStart(2, '0');\n    const ss = String(total % 60).padStart(2, '0');\n    return `${mm}:${ss}`;\n};\nconst tempo = (ms) => ({ payload: `TEMPO RESTANTE: ${fmt(ms)}` });\n\nconst AGUARDANDO = { payload: \"AGUARDANDO INÍCIO DO TESTE\", color: \"#B26A00\" };  // âmbar\n\nlet ativo   = flow.get('ativo');\nlet inicio  = flow.get(\"hora_inicio_date\");\nlet duracao = flow.get(\"duracao_teste\") || 3600000; // 1h\n\n// NUNCA INICIOU / NÃO ESTÁ ATIVO -> contagem parada\nif (!inicio || !ativo) {\n    let status = AGUARDANDO;\n    const aviso = flow.get('aviso_status');          // alerta de intertravamento (INICIAR bloqueado)\n    if (aviso && aviso.ate > Date.now()) status = { payload: aviso.payload, color: aviso.color };\n    return [tempo(duracao), null, status];\n}\n\nlet restante = (inicio + duracao) - Date.now();\n\n// CHEGOU EM ZERO -> FINALIZA AUTOMÁTICO\nif (restante <= 0 && ativo === true) {\n    flow.set('tempo_restante', 0);\n    flow.set('ativo', false);\n\n    // FINAL REAL\n    flow.set('hora_fim_date', Date.now());\n\n    // chama finalização automática\n    return [tempo(0), { payload: \"FINALIZAR_AUTO\" }, AGUARDANDO];\n}\n\n// CONTAGEM NORMAL\nflow.set('tempo_restante', Math.ceil(restante / 60000));   // mantido em minutos (compatibilidade)\n\nconst sp = flow.get('sp_travado');\nconst rodando = { payload: `TESTE RODANDO - SETPOINT ${sp !== undefined && sp !== null ? Number(sp).toFixed(2) : '--'} BAR`, color: \"#2E7D32\" };  // verde\nreturn [tempo(restante), null, rodando];\n",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 697.9545454545455,
        "wires": [
            [
                "82d8edb1336a7da3"
            ],
            [
                "6d54da2809aedd4d"
            ],
            [
                "a7c3f1d2b9e84f10"
            ]
        ]
    },
    {
        "id": "6d54da2809aedd4d",
        "type": "function",
        "z": "flow_pressao_full",
        "name": "Finaliza _Teste",
        "func": "// Entradas: botão FINALIZAR TESTE (payload 0) ou cronômetro (payload \"FINALIZAR_AUTO\").\n// Saídas: [0] livre | [1] relatório (HTML -> PDF) | [2] libera a UI ('PARADO') | [3] ciclo_node = false (CLP) | [4] ponto final do setpoint travado (InfluxDB)\nconst auto = msg.payload === 'FINALIZAR_AUTO';\nif (!auto && flow.get('ativo') !== true) return null;   // nenhum teste em andamento\n\nconst spTravado = flow.get('sp_travado');\n// SEMPRE libera a tela e zera o ciclo_node, mesmo que o relatório não possa ser gerado\nconst liberar = (rel) => {\n    flow.set('ativo', false);\n    return [\n        null,\n        rel,\n        { payload: 'PARADO' },\n        { payload: false },\n        (spTravado !== undefined && spTravado !== null && !isNaN(Number(spTravado))) ? { payload: Number(spTravado) } : null\n    ];\n};\n\n// Datas/horas SEMPRE no fuso e formato brasileiros (o contêiner roda em UTC)\nconst BR = 'America/Sao_Paulo';\nconst partesBR = (d) => {\n    const o = {};\n    new Intl.DateTimeFormat('pt-BR', {\n        timeZone: BR, year: 'numeric', month: '2-digit', day: '2-digit',\n        hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23'\n    }).formatToParts(new Date(d)).forEach(p => { o[p.type] = p.value; });\n    return o;\n};\nconst dataHoraBR = (d) => {\n    const o = partesBR(d);\n    return `${o.day}/${o.month}/${o.year} ${o.hour}:${o.minute}:${o.second}`;\n};\n\nlet soma = flow.get('soma') || 0;\nlet qtd = flow.get('qtd') || 1;\nlet media = soma / qtd;\n\nlet min = flow.get('min');\nlet max = flow.get('max');\nlet sp = Number(flow.get('sp_travado') ?? flow.get('sp') ?? 0) || 0;\nlet historico = flow.get('historico') || [];\n\n// PROTEÇÃO\nif (min == null || max == null || historico.length === 0) {\n    node.error(\"Dados insuficientes\");\n    return liberar(null);\n}\n\n// 🔥 TEMPO OFICIAL\nlet inicio = flow.get(\"hora_inicio_date\");\nlet fim = flow.get(\"hora_fim_date\") || Date.now();\n\nif (!inicio) {\n    node.error(\"hora_inicio_date não encontrada\");\n    return liberar(null);\n}\n\nlet fimDate = new Date(fim);\n\n// 🔥 NORMALIZA INÍCIO (remove segundos)\nlet inicioBase = new Date(inicio);\ninicioBase.setSeconds(0);\ninicioBase.setMilliseconds(0);\ninicio = inicioBase.getTime();\n\n// 🔥 HISTÓRICO FILTRADO\nlet historicoFiltrado = historico.filter(p => p.t >= inicio);\n\n// ERRO\nlet erro = sp - min;\nlet tolerancia = 0.5;\nlet status = erro <= tolerancia ? \"APROVADO\" : \"REPROVADO\";\n\n// ESCALA\nlet escala = 20;\n\n// 🔥 BASE FIXA 1H\nlet duracao = 60 * 60 * 1000;\n\n// 🔥 PONTOS\nlet pontos = \"\";\n\n// 🔥 PONTO INICIAL\nlet primeiroValor = historicoFiltrado.length > 0 ? historicoFiltrado[0].v : sp;\n\nlet x0 = 50;\nlet y0 = 240 - ((Number(primeiroValor) || 0) * escala);\n\npontos += x0 + \",\" + y0 + \" \";\n\n// 🔥 LINHA DA PRESSÃO\nhistoricoFiltrado.forEach((p) => {\n\n    if (p.t > fim) return;\n\n    let proporcao = (p.t - inicio) / duracao;\n\n    if (proporcao < 0) proporcao = 0;\n    if (proporcao > 1) proporcao = 1;\n\n    let x = 50 + (proporcao * 900);\n    let y = 240 - (Number(p.v) * escala);\n\n    pontos += x + \",\" + y + \" \";\n});\n\n// 🔥 SETPOINT\nlet linhaSP = 240 - (sp * escala);\n\n// 🔥 FALHA\nlet falhaX = null;\nlet falhaY = null;\nlet falhaValor = null;\n\nfor (let i = 0; i < historicoFiltrado.length; i++) {\n\n    let p = historicoFiltrado[i];\n\n    if (p.t > fim) break;\n\n    let erroPonto = sp - p.v;\n\n    if (erroPonto > tolerancia) {\n\n        let proporcao = (p.t - inicio) / duracao;\n\n        falhaX = 50 + (proporcao * 900);\n        falhaY = 240 - (Number(p.v) * escala);\n        falhaValor = Number(p.v).toFixed(2);\n\n        break;\n    }\n}\n\n// =======================================================\n// 🔥 EIXO X PERFEITO (5 EM 5 MIN)\n// =======================================================\n\nfunction horaOffset(min){\n    return new Date(inicio + (min * 60000))\n        .toLocaleTimeString('pt-BR', {\n            timeZone: BR,\n            hour:'2-digit',\n            minute:'2-digit'\n        });\n}\n\nlet t0  = horaOffset(0);\nlet t1  = horaOffset(5);\nlet t2  = horaOffset(10);\nlet t3  = horaOffset(15);\nlet t4  = horaOffset(20);\nlet t5  = horaOffset(25);\nlet t6  = horaOffset(30);\nlet t7  = horaOffset(35);\nlet t8  = horaOffset(40);\nlet t9  = horaOffset(45);\nlet t10 = horaOffset(50);\nlet t11 = horaOffset(55);\nlet t12 = horaOffset(60);\n\n// =======================================================\n\n// RELATÓRIO\nlet rel = {\n    equipamento: flow.get('equipamento_teste') ?? flow.get('equipamento'),\n\n    inicio: dataHoraBR(inicio),\n    fim: dataHoraBR(fimDate),\n\n    media: media.toFixed(2),\n    min: Number(min).toFixed(2),\n    max: Number(max).toFixed(2),\n\n    sp: sp,\n    erro: erro.toFixed(2),\n    status: status,\n\n    pontos: pontos,\n    linhaSP: linhaSP,\n\n    falhaX: falhaX,\n    falhaY: falhaY,\n    falhaValor: falhaValor,\n    falhaYTxt: falhaY !== null ? falhaY + 15 : null,\n\n    // 🔥 AGORA SIM COMPLETO\n    t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, t12\n};\n\n// RESET\nflow.set('tempo_restante', 60);\n\n// DATA DE EMISSÃO (formato brasileiro) exibida abaixo da assinatura\nlet agora = new Date();\nlet o = partesBR(agora);\nrel.emissao = `${o.day}/${o.month}/${o.year} - ${o.hour}:${o.minute}:${o.second}`;\n\n// NOME ÚNICO DO PDF: <Equipamento>_<DD-MM-AAAA_HH-mm-ss>.pdf (sanitizado, sem acentos/espaços)\nlet equip = String(flow.get('equipamento_teste') ?? flow.get('equipamento') ?? '')\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^A-Za-z0-9]+/g, '_')\n    .replace(/^_+|_+$/g, '')\n    .slice(0, 60) || 'Equipamento';\nlet carimbo = `${o.day}-${o.month}-${o.year}_${o.hour}-${o.minute}-${o.second}`;\n\n// Caminhos POSIX dentro do contêiner (/data/relatorios -> ./relatorios no host)\nmsg.filename = \"/data/relatorios/relatorio.html\";                      // HTML temporário renderizado pelo Chromium\nmsg.pdfFile  = \"/data/relatorios/\" + equip + \"_\" + carimbo + \".pdf\";   // PDF final, único por teste\n\nreturn liberar({ payload: rel, filename: msg.filename, pdfFile: msg.pdfFile });\n",
        "outputs": 5,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
