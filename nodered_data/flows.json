        "type": "function",
        "z": "flow_pressao_full",
        "name": "Cache Setpoint (CLP)",
        "func": "// Último setpoint lido do CLP (setpoint_node). Apenas memoriza; não grava no Influx.\nconst sp = Number(msg.payload);\nif (!isNaN(sp)) {\n    flow.set('sp_plc', sp);\n    flow.set('sp_plc_t', Date.now());\n}\nreturn null;",
        "outputs": 0,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 720,
