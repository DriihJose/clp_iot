    {
        "id": "7d655f418f1c0085",
        "type": "function",
        "z": "flow_pressao_full",
        "name": "Coleta pressão",
        "func": "let ativo = flow.get('ativo');\n\n//if (!ativo) return null; // só grava quando ativo\n\nlet valor = Number(msg.payload);\n\n// ignora valores inválidos (0, null, NaN)\n if (!valor || valor <= 0) return null;\n\n// média\nlet soma = flow.get('soma') || 0;\nlet qtd = flow.get('qtd') || 0;\n\nsoma += valor;\nqtd += 1;\n\nflow.set('soma', soma);\nflow.set('qtd', qtd);\n\n// min max\nlet min = flow.get('min');\nlet max = flow.get('max');\n\nif (min === null || valor < min) flow.set('min', valor);\nif (max === null || valor > max) flow.set('max', valor);\n\n// histórico LIMPO\nlet historico = flow.get('historico') || [];\n\nhistorico.push({\n    v: valor,\n    t: Date.now()\n});\n\n//  mantém só últimos 10 minutos (ajustável)\nlet agora = Date.now();\nhistorico = historico.filter(p => agora - p.t <= 600000);\n\nflow.set('historico', historico);\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 740,
        "wires": [
            [
                "gauge",
                "bb3820654f2359db"
            ]
        ]
    },
    {
        "id": "5214bd83dc5b5467",
        "type": "function",
        "z": "flow_pressao_full",
        "name": "Decremento de tempo",
        "func": "let ativo = flow.get('ativo');\n\nlet inicio = flow.get(\"hora_inicio_date\");\nlet duracao = flow.get(\"duracao_teste\") || 3600000; // 1h\n\n// NUNCA INICIOU\nif (!inicio) {\n    return { payload: \"TEMPO RESTANTE 60 MIN\" };\n}\n\n// NÃO ESTÁ ATIVO\nif (!ativo) {\n    return { payload: \"TEMPO RESTANTE 60 MIN\" };\n}\n\nlet agora = Date.now();\nlet restante = (inicio + duracao) - agora;\n\n// CHEGOU EM ZERO → FINALIZA AUTOMÁTICO\nif (restante <= 0 && ativo === true) {\n\n    flow.set('tempo_restante', 0);\n    flow.set('ativo', false);\n\n    // FINAL REAL \n    flow.set('hora_fim_date', Date.now());\n\n    // chama finalização automática\n    node.send([null, { payload: \"FINALIZAR_AUTO\" }]);\n\n    return { payload: \"TEMPO RESTANTE 0 MIN\" };\n}\n\n// CONTAGEM NORMAL\nlet min = Math.ceil(restante / 60000);\n\nflow.set('tempo_restante', min);\n\nmsg.payload = `TEMPO RESTANTE ${min} MIN`;\n\nreturn msg;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 660,
        "wires": [
            [
                "82d8edb1336a7da3"
            ],
            [
                "6d54da2809aedd4d"
            ]
        ]
    },
    {
        "id": "6d54da2809aedd4d",
        "type": "function",
        "z": "flow_pressao_full",
        "name": "Finaliza _Teste",
        "func": "let soma = flow.get('soma') || 0;\nlet qtd = flow.get('qtd') || 1;\nlet media = soma / qtd;\n\nlet min = flow.get('min');\nlet max = flow.get('max');\nlet sp = flow.get('sp') || 0;\nlet historico = flow.get('historico') || [];\n\n// PROTEÇÃO\nif (min == null || max == null || historico.length === 0) {\n    node.error(\"Dados insuficientes\");\n    return null;\n}\n\n// 🔥 TEMPO OFICIAL\nlet inicio = flow.get(\"hora_inicio_date\");\nlet fim = flow.get(\"hora_fim_date\") || Date.now();\n\nif (!inicio) {\n    node.error(\"hora_inicio_date não encontrada\");\n    return null;\n}\n\nlet fimDate = new Date(fim);\n\n// 🔥 NORMALIZA INÍCIO (remove segundos)\nlet inicioBase = new Date(inicio);\ninicioBase.setSeconds(0);\ninicioBase.setMilliseconds(0);\ninicio = inicioBase.getTime();\n\n// 🔥 HISTÓRICO FILTRADO\nlet historicoFiltrado = historico.filter(p => p.t >= inicio);\n\n// ERRO\nlet erro = sp - min;\nlet tolerancia = 0.5;\nlet status = erro <= tolerancia ? \"APROVADO\" : \"REPROVADO\";\n\n// ESCALA\nlet escala = 20;\n\n// 🔥 BASE FIXA 1H\nlet duracao = 60 * 60 * 1000;\n\n// 🔥 PONTOS\nlet pontos = \"\";\n\n// 🔥 PONTO INICIAL\nlet primeiroValor = historicoFiltrado.length > 0 ? historicoFiltrado[0].v : sp;\n\nlet x0 = 50;\nlet y0 = 240 - ((Number(primeiroValor) || 0) * escala);\n\npontos += x0 + \",\" + y0 + \" \";\n\n// 🔥 LINHA DA PRESSÃO\nhistoricoFiltrado.forEach((p) => {\n\n    if (p.t > fim) return;\n\n    let proporcao = (p.t - inicio) / duracao;\n\n    if (proporcao < 0) proporcao = 0;\n    if (proporcao > 1) proporcao = 1;\n\n    let x = 50 + (proporcao * 900);\n    let y = 240 - (Number(p.v) * escala);\n\n    pontos += x + \",\" + y + \" \";\n});\n\n// 🔥 SETPOINT\nlet linhaSP = 240 - (sp * escala);\n\n// 🔥 FALHA\nlet falhaX = null;\nlet falhaY = null;\nlet falhaValor = null;\n\nfor (let i = 0; i < historicoFiltrado.length; i++) {\n\n    let p = historicoFiltrado[i];\n\n    if (p.t > fim) break;\n\n    let erroPonto = sp - p.v;\n\n    if (erroPonto > tolerancia) {\n\n        let proporcao = (p.t - inicio) / duracao;\n\n        falhaX = 50 + (proporcao * 900);\n        falhaY = 240 - (Number(p.v) * escala);\n        falhaValor = Number(p.v).toFixed(2);\n\n        break;\n    }\n}\n\n// =======================================================\n// 🔥 EIXO X PERFEITO (5 EM 5 MIN)\n// =======================================================\n\nfunction horaOffset(min){\n    return new Date(inicio + (min * 60000))\n        .toLocaleTimeString('pt-BR', {\n            hour:'2-digit',\n            minute:'2-digit'\n        });\n}\n\nlet t0  = horaOffset(0);\nlet t1  = horaOffset(5);\nlet t2  = horaOffset(10);\nlet t3  = horaOffset(15);\nlet t4  = horaOffset(20);\nlet t5  = horaOffset(25);\nlet t6  = horaOffset(30);\nlet t7  = horaOffset(35);\nlet t8  = horaOffset(40);\nlet t9  = horaOffset(45);\nlet t10 = horaOffset(50);\nlet t11 = horaOffset(55);\nlet t12 = horaOffset(60);\n\n// =======================================================\n\n// RELATÓRIO\nlet rel = {\n    equipamento: flow.get('equipamento'),\n\n    inicio: new Date(inicio).toLocaleString('pt-BR'),\n    fim: fimDate.toLocaleString('pt-BR'),\n\n    media: media.toFixed(2),\n    min: Number(min).toFixed(2),\n    max: Number(max).toFixed(2),\n\n    sp: sp,\n    erro: erro.toFixed(2),\n    status: status,\n\n    pontos: pontos,\n    linhaSP: linhaSP,\n\n    falhaX: falhaX,\n    falhaY: falhaY,\n    falhaValor: falhaValor,\n\n    // 🔥 AGORA SIM COMPLETO\n    t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, t12\n};\n\n// RESET\nflow.set('ativo', false);\nflow.set('tempo_restante', 60);\n\n// SAÍDA\nlet agora = new Date();\nlet nome = \"Relatorio_\" + agora.toISOString().replace(/[:.]/g, \"-\") + \".html\";\n\nmsg.filename = \"C:/RelatoriosTestePressao/\" + nome;\n\nreturn [null, { payload: rel, filename: msg.filename }];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 600,
        "wires": [
            [],
            [
                "8525c1d000560d34"
            ]
        ]
    },
    {
        "id": "49589c46b3396a0f",
        "type": "function",
        "z": "flow_pressao_full",
        "name": "Inicia teste",
        "func": "flow.set('ativo', true);\nflow.set('inicio', new Date().toLocaleString('pt-BR'));\n\nflow.set('soma', 0);\nflow.set('qtd', 0);\nflow.set('min', null);\nflow.set('max', null);\n\n// limpa histórico\nflow.set('historico', []);\n\n//  hora oficial de início\nflow.set(\"hora_inicio_date\", Date.now());\n\n//  duração padrão (1h)\nflow.set(\"duracao_teste\", 3600000);\n\n//  IMPORTANTE: limpa fim anterior\nflow.set(\"hora_fim_date\", null);\n\nmsg.topic = 'N7:0';\nmsg.payload = 1;\n\nreturn msg;",
