    {
        "id": "8525c1d000560d34",
        "type": "template",
        "z": "flow_pressao_full",
        "name": "Relatório  HTML",
        "field": "payload",
        "fieldType": "msg",
        "format": "html",
        "syntax": "mustache",
        "template": "<meta charset=\"UTF-8\">\n\n<style>\n    body {\n        font-family: Arial;\n        margin: 40px;\n    }\n\n    .container {\n        border: 2px solid #000;\n        padding: 20px;\n    }\n\n    h1 {\n        text-align: center;\n        margin-bottom: 20px;\n    }\n\n    .linha {\n        margin: 8px 0;\n    }\n\n    .box {\n        margin-top: 20px;\n        padding: 10px;\n        border: 1px solid #000;\n    }\n\n    .assinatura {\n        margin-top: 40px;\n    }\n</style>\n\n<div class=\"container\">\n\n    <h1>RELATÓRIO DE TESTE DE PRESSÃO</h1>\n\n    <div class=\"linha\"><b>Equipamento:</b> {{payload.equipamento}}</div>\n    <div class=\"linha\"><b>Início:</b> {{payload.inicio}}</div>\n    <div class=\"linha\"><b>Fim:</b> {{payload.fim}}</div>\n\n    <div class=\"box\">\n        <div class=\"linha\"><b>Setpoint:</b> {{payload.sp}} bar</div>\n        <div class=\"linha\"><b>Média:</b> {{payload.media}} bar</div>\n        <div class=\"linha\"><b>Mínima:</b> {{payload.min}} bar</div>\n        <div class=\"linha\"><b>Máxima:</b> {{payload.max}} bar</div>\n        <div class=\"linha\"><b>Erro Máximo:</b> {{payload.erro}} bar</div>\n\n        <div class=\"linha\">\n            <b>Status:</b>\n            <span style=\"color: {{payload.status == 'APROVADO' ? 'green' : 'red'}};\">\n                {{payload.status}}\n            </span>\n        </div>\n    </div>\n\n    <br>\n    <div class=\"Gráfiico de Pressão\" style=\"text-align:center;\">\n     <h3>Gráfico de Pressão</h3>\n\n<div style=\"text-align: center;\">\n    <svg width=\"1000\" height=\"300\" style=\"border:1px solid #000\">\n\n        <!-- eixo -->\n        <line x1=\"50\" y1=\"240\" x2=\"950\" y2=\"240\" stroke=\"black\" />\n\n        <!-- escala Y -->\n        <text x=\"20\" y=\"240\">0</text>\n        <text x=\"20\" y=\"220\">1</text>\n        <text x=\"20\" y=\"200\">2</text>\n        <text x=\"20\" y=\"180\">3</text>\n        <text x=\"20\" y=\"160\">4</text>\n        <text x=\"20\" y=\"140\">5</text>\n        <text x=\"20\" y=\"120\">6</text>\n        <text x=\"20\" y=\"100\">7</text>\n        <text x=\"20\" y=\"80\">8</text>\n        <text x=\"20\" y=\"60\">9</text>\n        <text x=\"20\" y=\"40\">10</text>\n\n        <!-- grid -->\n        <line x1=\"50\" y1=\"220\" x2=\"950\" y2=\"220\" stroke=\"#ccc\" />\n        <line x1=\"50\" y1=\"200\" x2=\"950\" y2=\"200\" stroke=\"#ccc\" />\n        <line x1=\"50\" y1=\"180\" x2=\"950\" y2=\"180\" stroke=\"#ccc\" />\n        <line x1=\"50\" y1=\"160\" x2=\"950\" y2=\"160\" stroke=\"#ccc\" />\n        <line x1=\"50\" y1=\"140\" x2=\"950\" y2=\"140\" stroke=\"#ccc\" />\n        <line x1=\"50\" y1=\"120\" x2=\"950\" y2=\"120\" stroke=\"#ccc\" />\n        <line x1=\"50\" y1=\"100\" x2=\"950\" y2=\"100\" stroke=\"#ccc\" />\n        <line x1=\"50\" y1=\"80\" x2=\"950\" y2=\"80\" stroke=\"#ccc\" />\n        <line x1=\"50\" y1=\"60\" x2=\"950\" y2=\"60\" stroke=\"#ccc\" />\n        <line x1=\"50\" y1=\"40\" x2=\"950\" y2=\"40\" stroke=\"#ccc\" />\n\n        <!-- pressão -->\n        <polyline fill=\"none\" stroke=\"blue\" stroke-width=\"2\" points=\"{{payload.pontos}}\" />\n\n        <!-- setpoint -->\n        <line x1=\"50\" y1=\"{{payload.linhaSP}}\" x2=\"950\" y2=\"{{payload.linhaSP}}\" stroke=\"red\" stroke-dasharray=\"5,5\" />\n\n        <!-- 🔴 PONTO DA FALHA -->\n        {{#payload.falhaX}}\n        <circle cx=\"{{payload.falhaX}}\" cy=\"{{payload.falhaY}}\" r=\"5\" fill=\"red\" />\n\n        <text x=\"{{payload.falhaX}}\" y=\"{{payload.falhaY + 15}}\" font-size=\"12\" text-anchor=\"middle\" fill=\"red\">\n            {{payload.falhaValor}} bar\n        </text>\n        {{/payload.falhaX}}\n\n        <!-- eixo X corrigido -->\n        <text x=\"50\" y=\"270\">{{payload.t0}}</text>\n<text x=\"125\" y=\"270\">{{payload.t1}}</text>\n<text x=\"200\" y=\"270\">{{payload.t2}}</text>\n<text x=\"275\" y=\"270\">{{payload.t3}}</text>\n<text x=\"350\" y=\"270\">{{payload.t4}}</text>\n<text x=\"425\" y=\"270\">{{payload.t5}}</text>\n<text x=\"500\" y=\"270\">{{payload.t6}}</text>\n<text x=\"575\" y=\"270\">{{payload.t7}}</text>\n<text x=\"650\" y=\"270\">{{payload.t8}}</text>\n<text x=\"725\" y=\"270\">{{payload.t9}}</text>\n<text x=\"800\" y=\"270\">{{payload.t10}}</text>\n<text x=\"875\" y=\"270\">{{payload.t11}}</text>\n<text x=\"950\" y=\"270\">{{payload.t12}}</text>\n\n        <!-- legenda -->\n        <line x1=\"200\" y1=\"285\" x2=\"230\" y2=\"285\" stroke=\"blue\" stroke-width=\"2\" />\n        <text x=\"240\" y=\"290\" fill=\"blue\">Pressão</text>\n\n        <line x1=\"620\" y1=\"285\" x2=\"530\" y2=\"285\" stroke=\"red\" stroke-dasharray=\"5,5\" />\n        <text x=\"640\" y=\"290\" fill=\"red\">Setpoint</text>\n\n    </svg>\n\n    <div class=\"assinatura\" style=\"text-align:center;\">\n        <div class=\"linha\">_____________________________________</div>\n        <div class=\"linha\">Responsável pelo teste</div>\n    </div>",
        "x": 780,
        "y": 560,
        "wires": [
            [
                "4e72940d3bb63eec"
            ]
        ]
